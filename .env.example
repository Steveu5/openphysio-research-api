# Required: Supabase project used by OpenPhysio authentication and research data
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required: server-side DeepSeek credential
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
# Optional: model id (default deepseek-flash) and thinking mode (default disabled)
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled

# Production HTTP configuration
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://your-openphysio-frontend.example

# Research defaults
DEFAULT_RESULT_LIMIT=10
ANSWER_ARTICLE_LIMIT=10
CACHE_TTL_HOURS=24

# Usage allowances (Chat 200 / Research 100 per UTC month; trial 20 / 10)
# are product policy in src/config/usagePlans.js, not environment variables.

# Recommended for responsible PubMed / NCBI usage
NCBI_EMAIL=you@example.com
NCBI_API_KEY=
