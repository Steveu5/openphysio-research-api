# Copy to .env.test.local (ignored by git) and run: APP_ENV=test npm test
# Local Supabase only (values printed by `npx supabase start` in openphysio-frontend).
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Separate DeepSeek test account/key with a small prepaid balance. Leave empty = no AI calls.
DEEPSEEK_TEST_API_KEY=
DEEPSEEK_TEST_MAX_CALLS=20
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
PORT=3000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:4173
